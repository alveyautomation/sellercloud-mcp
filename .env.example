# SellerCloud REST API base URL.
# Most teams have a tenant-specific subdomain. Replace `your-team` below with
# yours, or set the full URL to whatever SellerCloud provided.
SELLERCLOUD_API_URL=https://your-team.api.sellercloud.com/rest/

# SellerCloud account credentials. The MCP server uses these to obtain a bearer
# token via `POST /api/token`. Use a read-only / minimum-privilege account where
# possible — v0.1 only exposes read endpoints, but defense in depth still
# applies.
SELLERCLOUD_USERNAME=replace-me
SELLERCLOUD_PASSWORD=replace-me

# Optional: default CompanyID to use when a tool call omits it.
# Leave blank to require an explicit `company_id` on every call.
SELLERCLOUD_DEFAULT_COMPANY_ID=

# Optional: HTTP request timeout in seconds. Default 60.
SELLERCLOUD_HTTP_TIMEOUT=60

# Optional: number of retry attempts on transient errors (5xx, timeout). Default 3.
SELLERCLOUD_MAX_RETRIES=3
